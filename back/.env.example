# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=callcenter

# JWT Authentication
JWT_SECRET=change-this-to-a-random-64-char-string

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=changeme

# Google AI
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# OpenAI (for embeddings)
OPENAI_API_KEY=your-openai-api-key

# MinIO / S3
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=recordings

# Redis
REDIS_CONNECTION=redis:6379

# CORS
CORS_ORIGINS=http://localhost:5173

# AI Worker
PERSONA_ID=
AGENT_VOICE=Aoede
AGENT_TEMPERATURE=0.7
AGENT_MODEL=models/gemini-3.1-flash-live-preview
BACKEND_URL=http://backend:5000

# ── v0 LiveKit-SIP calling ─────────────────────────────────────────────
# Shared service token for worker->backend shims and webhook (empty = allow, dev)
BACKEND_SERVICE_TOKEN=
# Worker dispatch name (must match backend InboundRoutingService.DispatchAgentName)
AGENT_NAME=voice-agent
# sip-setup.py inputs (docker compose --profile setup run --rm sip-setup)
PBX_IP=
SIP_DIDS=
OWNER_USER_ID=
# Emitted by sip-setup.py; required for destination transfers
LIVEKIT_OUTBOUND_TRUNK_ID=
